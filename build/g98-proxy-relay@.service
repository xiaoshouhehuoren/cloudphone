[Unit]
Description=G98 proxy relay from docker0 to reverse SSH tunnel (port %i)
After=network-online.target docker.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/socat TCP-LISTEN:%i,bind=172.17.0.1,reuseaddr,fork TCP:127.0.0.1:%i
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
