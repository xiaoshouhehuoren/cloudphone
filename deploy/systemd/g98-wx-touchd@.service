[Unit]
Description=G98 wx%i touch bridge
After=docker.service
PartOf=g98-wx@%i.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /srv/redroid/wx-touchd.py %i --tcp 127.0.0.1:1810%i
ExecStopPost=-/bin/rm -f /run/g98/wx-touch-%i.sock
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
