service g98-sensors /vendor/bin/g98-sensors.sh
    user root
    group root system
    disabled

# 必须在 "on boot" 阶段就启动：system_server 启动时会同步等待
# android.hardware.sensors.ISensors/default（VINTF 已声明），HAL 缺席会死锁在
# "Waited one second for ... ISensors"，sys.boot_completed 永远为空、PackageManager
# 解析不出任何 Activity。晚启动（on property:sys.boot_completed=1）已实测会卡死开机。
on boot
    start g98-sensors

# 兜底：若 boot 阶段未起来，开机完成后再补一次（启动脚本自身幂等）。
on property:sys.boot_completed=1
    start g98-sensors
